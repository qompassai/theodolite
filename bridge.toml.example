# theodolite bridge config — copy to the target machine and pin the
# ACTUAL binary paths and version strings found there. The bridge
# probes each binary at session start and refuses a mismatch; never
# point `binary` at a rustup proxy (proxies need ambient env the
# bridge deliberately scrubs — pin the toolchain's real binary).
#
# Timeouts are config data; the defaults below are the SPEC values.

# request_timeout_ms = 60000
# ready_timeout_ms = 30000
# shutdown_grace_ms = 2000
#
# Mutation posture (P5): "off" (default) registers no apply tools.
# "gated" registers code_action_apply / rename_apply ONLY for MCP
# clients whose handshake clientInfo.name appears in
# mutation_allowlist. gated requires a non-empty allowlist, and an
# allowlist while off is refused at startup — an ambiguous posture
# is a typed ConfigInvalid, never a silent default.
mutation = "off"
# mutation = "gated"
# mutation_allowlist = ["my-agent"]

[[server]]
id = "bacon-ls"
binary = "/home/phaedrus/.cargo/bin/bacon-ls"
version_probe = ["--version"]
expect_version = "RECORD-ON-TARGET-MACHINE"
languages = ["rust"]
extensions = ["rs"]
language_ids = { rs = "rust" }
readiness = "immediate"
diagnostics_owner = true
env = { PATH = "/home/phaedrus/.cargo/bin:/usr/local/bin:/usr/bin:/bin" }

[[server]]
id = "rust-analyzer"
binary = "/usr/bin/rust-analyzer"
version_probe = ["--version"]
expect_version = "RECORD-ON-TARGET-MACHINE"
languages = ["rust"]
extensions = ["rs"]
language_ids = { rs = "rust" }
readiness = "quiescent"
env = { PATH = "/home/phaedrus/.cargo/bin:/usr/local/bin:/usr/bin:/bin" }

[[server]]
id = "lua-language-server"
binary = "/usr/bin/lua-language-server"
version_probe = ["--version"]
expect_version = "RECORD-ON-TARGET-MACHINE"
languages = ["lua"]
extensions = ["lua"]
language_ids = { lua = "lua" }
readiness = "immediate"
env = {}

# serve-d (D): plain stdio LSP, no argv — upstream's `--require`
# values are feature names (`d`, `workspaces`), never component
# names; an unsupported value makes serve-d refuse to start.
# `first-response`: serve-d loads the dub workspace and starts
# DCD after the handshake on its own schedule; its indexing
# never presents a quiescent window inside the readiness
# timeout, so readiness is the handshake plus the first real
# answered request against a workspace file. It spawns
# `dub`/`dcd-server` by name, so PATH must carry them.
# serve-d prints its version on stderr only; the probe accepts
# the trimmed stderr when stdout is empty (SPEC §4.1).
# Primo note (2026-10-26): the packaged serve-d 0.7.6-1 there
# cannot launch (it needs libphobos2-ldc-shared.so.111; the
# system LDC 1.43 ships .113). A source-built serve-d exists at
# ~/.local/bin/serve-d — point the machine copy's `binary`
# there; live parity against it PASSED 2026-10-26 (bridge
# document_symbols + hover match a direct probe exactly). See
# README "Capability notes".
[[server]]
id = "serve-d"
binary = "/usr/bin/serve-d"
version_probe = ["--version"]
expect_version = "RECORD-ON-TARGET-MACHINE"
languages = ["d"]
extensions = ["d", "di"]
language_ids = { d = "d", di = "d" }
readiness = "first-response"
env = { PATH = "/usr/local/bin:/usr/bin:/bin" }
