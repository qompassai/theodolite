# theodolite bridge config — copy to the target machine and pin the
# ACTUAL binary paths and version strings found there. The bridge
# probes each binary at session start and refuses a mismatch; never
# point `binary` at a rustup proxy (proxies need ambient env the
# bridge deliberately scrubs — pin the toolchain's real binary).
#
# Timeouts are config data; the defaults below are the SPEC values.
#
# Slice 0 rule (coverage SPEC §3): a workspace-loading server
# (the rust-analyzer class) pairs readiness = "quiescent" with a
# ready_timeout_ms sized for a COLD workspace load — the estate's
# canonical config uses 300000, because the 30000 default proved
# too small for a cold index and pushed sessions into the
# immediate-readiness shape that served pre-load empties. Servers
# that stay on "immediate" are covered by the bridge's marker
# instead: a read-class result served before the server has ever
# reported quiescence carries
# possibly_incomplete = "server_not_quiescent".

# request_timeout_ms = 60000
# ready_timeout_ms = 30000
# shutdown_grace_ms = 2000
#
# Mutation posture (P5): "off" (default) registers no apply tools.
# "gated" registers code_action_apply / rename_apply ONLY for MCP
# clients whose handshake clientInfo.name appears in
# mutation_allowlist. gated requires a non-empty allowlist, and an
# allowlist while off is refused at startup — an ambiguous posture
# is a typed ConfigInvalid, never a silent default.
mutation = "off"
# mutation = "gated"
# mutation_allowlist = ["my-agent"]

[[server]]
id = "bacon-ls"
binary = "/home/phaedrus/.cargo/bin/bacon-ls"
version_probe = ["--version"]
expect_version = "RECORD-ON-TARGET-MACHINE"
languages = ["rust"]
extensions = ["rs"]
language_ids = { rs = "rust" }
readiness = "immediate"
diagnostics_owner = true
env = { PATH = "/home/phaedrus/.cargo/bin:/usr/local/bin:/usr/bin:/bin" }

[[server]]
id = "rust-analyzer"
binary = "/usr/bin/rust-analyzer"
version_probe = ["--version"]
expect_version = "RECORD-ON-TARGET-MACHINE"
languages = ["rust"]
extensions = ["rs"]
language_ids = { rs = "rust" }
readiness = "quiescent"
env = { PATH = "/home/phaedrus/.cargo/bin:/usr/local/bin:/usr/bin:/bin" }

[[server]]
id = "lua-language-server"
binary = "/usr/bin/lua-language-server"
version_probe = ["--version"]
expect_version = "RECORD-ON-TARGET-MACHINE"
languages = ["lua"]
extensions = ["lua"]
language_ids = { lua = "lua" }
readiness = "immediate"
env = {}

# nil (Nix): nil publishes publishDiagnostics ONLY for non-empty
# sets — a clean file gets no notification at all, so the
# bridge's evidence-based settle wait can never settle for
# exactly the files whose answer is empty, and the call fails
# ServerNotReady at the ready deadline. The opt-in below is the
# scoped cure: after 5000 ms of silence following the last
# content sync (nothing in flight, diagnostics generation
# stable), the absent publish IS the empty set. nil's publish
# for a dirty file lands in ~0.6 s, so the window carries ~8x
# headroom. NEVER opt in a server that publishes empty sets or
# publishes slowly: for every server without the opt-in,
# silence stays ServerNotReady, and a publish arriving after
# the window is indistinguishable from silence.
[[server]]
id = "nil"
binary = "/usr/bin/nil"
version_probe = ["--version"]
expect_version = "RECORD-ON-TARGET-MACHINE"
languages = ["nix"]
extensions = ["nix"]
language_ids = { nix = "nix" }
readiness = "immediate"
diagnostics_owner = true
no_publish_means_empty_ms = 5000
env = { PATH = "/usr/local/bin:/usr/bin:/bin" }

# serve-d (D): plain stdio LSP, no argv — upstream's `--require`
# values are feature names (`d`, `workspaces`), never component
# names; an unsupported value makes serve-d refuse to start.
# `first-response`: serve-d loads the dub workspace and starts
# DCD after the handshake on its own schedule; its indexing
# never presents a quiescent window inside the readiness
# timeout, so readiness is the handshake plus the first real
# answered request against a workspace file. It spawns
# `dub`/`dcd-server` by name, so PATH must carry them.
# serve-d prints its version on stderr only; the probe accepts
# the trimmed stderr when stdout is empty (SPEC §4.1).
# Primo note (2026-10-26): the packaged serve-d 0.7.6-1 there
# cannot launch (it needs libphobos2-ldc-shared.so.111; the
# system LDC 1.43 ships .113). A source-built serve-d exists at
# ~/.local/bin/serve-d — point the machine copy's `binary`
# there; live parity against it PASSED 2026-10-26 (bridge
# document_symbols + hover match a direct probe exactly). See
# README "Capability notes".
[[server]]
id = "serve-d"
binary = "/usr/bin/serve-d"
version_probe = ["--version"]
expect_version = "RECORD-ON-TARGET-MACHINE"
languages = ["d"]
extensions = ["d", "di"]
language_ids = { d = "d", di = "d" }
readiness = "first-response"
env = { PATH = "/usr/local/bin:/usr/bin:/bin" }

# --- Checkers -----------------------------------------------------
#
# A [[checker]] stanza is NOT a language server: it pins a
# one-shot command-line tool the bridge runs per document, on
# sync, feeding the document's exact bytes on stdin and parsing
# the tool's output through a named, versioned parser profile
# (v1 has exactly one: "glslang-validator-1"). Checkers serve
# `diagnostics` and `session_status` only; every other tool
# refuses a checker id. Checker results are never merged with a
# server's diagnostics.
#
# `authority` is required and has no default:
# - "cross-check" — the checker runs only when a caller names its
#   id explicitly, and its set is returned labelled, beside the
#   owning server's set, never instead of it. A disagreement
#   between a cross-check and the diagnostics owner is a
#   conformance incident to investigate, not a vote.
# - "owner" — the checker IS the diagnostics route for its
#   extensions. Config load refuses an owner checker claiming an
#   extension a diagnostics-owner [[server]] claims, and refuses
#   two owner checkers on one extension: ownership is settled at
#   load, never negotiated at call time.
#
# Server and checker ids share one namespace. Extension routing
# (`server` omitted / by extension) considers [[server]] entries
# only — a checker is reachable solely by its explicit id.
#
# The command is an argv vector, executed directly, never through
# a shell. Placeholders substitute as whole elements only
# ({path}, {relpath}, {stage}, {file_dir}, {project_root},
# {output}, {depfile}); {output} and {depfile} are per-run
# bridge-owned temp paths. One profile exception: glslang takes
# its include directory glued ("-I<dir>" — a split "-I" is a
# command-line error to the tool), so the two glued forms below
# are admitted, in this order (the file's own directory first,
# then the project root). The project root is the first directory
# walking up from the file (workspace root at the latest) that
# holds any of `root_markers`; the child runs with that as cwd.
#
# Bounds are refused outside their ranges at load: debounce_ms
# 0..=5000, timeout_ms 100..=120000, max_input_bytes
# 65536..=16777216, max_output_bytes 65536..=4194304,
# max_diagnostics 1..=512. Crossing a bound at run time is a
# typed error, never a truncated answer.

[[checker]]
id = "glslang-vulkan-crosscheck"
parser = "glslang-validator-1"
binary = "/usr/bin/glslangValidator"
version_probe = ["--version"]
expect_version = "RECORD-ON-TARGET-MACHINE"
languages = ["glsl"]
extensions = ["frag", "vert", "geom", "comp", "tesc", "tese", "glsl"]
language_ids = { frag = "glsl", vert = "glsl", geom = "glsl", comp = "glsl", tesc = "glsl", tese = "glsl", glsl = "glsl" }
stage_by_extension = { frag = "frag", vert = "vert", geom = "geom", comp = "comp", tesc = "tesc", tese = "tese" }
authority = "cross-check"
trigger = "on-sync"
root_markers = [".git", "shaders.toml"]
command = ["/usr/bin/glslangValidator", "-V", "--target-env", "vulkan1.3", "--error-column", "--stdin", "-S", "{stage}", "-I{file_dir}", "-I{project_root}", "--depfile", "{depfile}", "-o", "{output}"]
env = { PATH = "/usr/local/bin:/usr/bin:/bin" }
