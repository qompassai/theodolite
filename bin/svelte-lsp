#!/bin/sh
# Theodolite bridge wrapper for svelte-language-server 0.18.6
# (npm package svelte-language-server, installed into
# ~/.local/share/theodolite/svelte-ls on 2026-11-28). The server
# only serves with --stdio and has no --version exit path, so the
# probe is answered here from the installed package version
# (package.json "version": "0.18.6").
if [ "$1" = "--version" ]; then echo "svelte-language-server 0.18.6"; exit 0; fi
exec /home/phaedrus/.local/share/theodolite/svelte-ls/node_modules/.bin/svelteserver --stdio
