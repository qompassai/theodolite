#!/usr/bin/env python3
"""checkmake-check 1.0.0 -- theodolite checker wrapper (glslang profile).

Runs checkmake (-o json) over .mk files and translates violations
into the bridge's glslang info-log grammar. All checkmake rules are
lint-class: WARNING. Boundary: the bridge routes by extension, so
an extensionless Makefile is not routable here; *.mk includes are.
checkmake exit codes: 0 clean, 1 violations; anything else fails
loud.
"""
import json
import subprocess
import sys

VERSION = "checkmake-check 1.0.0"
CHECKMAKE = "/usr/bin/checkmake"


def fail_loud(detail):
    sys.stdout.write("checkmake-check: unparseable output: %s\n" % detail)
    return 1


def main(argv):
    if argv and argv[0] == "--version":
        out = subprocess.run([CHECKMAKE, "--version"], capture_output=True,
                             text=True).stdout.splitlines()
        print(VERSION)
        print(out[0].strip() if out else "checkmake unknown")
        return 0

    args = argv[1:] if argv and argv[0] == "--" else argv
    try:
        out_idx = args.index("-o") if "-o" in args else args.index("--output")
        output_path = args[out_idx + 1]
        dep_idx = args.index("--depfile")
        depfile_path = args[dep_idx + 1]
        target = args[-1]
    except (ValueError, IndexError):
        return fail_loud("argv shape")

    with open(depfile_path, "w", encoding="utf-8") as f:
        f.write("%s: %s\n" % (output_path, target))
    with open(output_path, "w", encoding="utf-8"):
        pass

    proc = subprocess.run([CHECKMAKE, "-o", "json", target],
                          capture_output=True, text=True)
    if proc.returncode not in (0, 1):
        return fail_loud("checkmake exit %d: %s" % (proc.returncode,
                                                    proc.stderr.strip()[:200]))
    try:
        findings = json.loads(proc.stdout or "[]")
    except ValueError:
        return fail_loud(proc.stdout[:200])

    diags = []
    for f in findings:
        diags.append((int(f.get("line_number", 1)), 1, "WARNING",
                      "%s %s" % (f.get("rule", ""), f.get("violation", ""))))
    diags.sort(key=lambda d: (d[0], d[1]))

    err = sys.stderr
    err.write("stdin\n")
    for line_no, col, sev, msg in diags:
        err.write("%s: stdin:%d:%d: %s\n" % (sev, line_no, col, msg))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
