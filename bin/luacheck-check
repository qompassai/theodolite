#!/usr/bin/env python3
"""luacheck-check 1.0.0 -- theodolite checker wrapper (glslang profile).

Runs luacheck (estate scope-analysis gate: catches the
forward-reference hazard class -- "accessing undefined variable X"
paired with "unused function X" -- that LuaLS is blind to) and
translates its plain-with-codes output into the bridge's glslang
info-log grammar.

Config law: .luacheckrc is discovered by walking up from the real
file's directory ({file_dir}) and passed explicitly via --config,
so the estate's globals/ignore rules (Diver's live .luacheckrc is
the reference) apply. Boundary, recorded honestly: luacheck's
path-keyed `files[...]` overrides match against the path as
passed, and the bridge hands this wrapper a temp path -- so
path-keyed overrides do NOT apply on the bridge route; the
scope-analysis signal (the reason this checker exists) is
path-independent. For exact rc path semantics, run luacheck
directly.

luacheck exit codes: 0 clean, 1 warnings, 2 errors (incl. syntax),
3+ fatal. Unparseable output or an unexpected exit fails loud
(garbage line + exit 1) -- never a silent zero.
"""
import os
import re
import subprocess
import sys

VERSION = "luacheck-check 1.0.0"
LUACHECK = "/home/phaedrus/.local/bin/luacheck"

LINE_RE = re.compile(r"^.+?:(\d+):(\d+)(?:-\d+)?: \(([WE]\d+)\) (.*)$")


def fail_loud(detail):
    sys.stdout.write("luacheck-check: unparseable luacheck output: %s\n" % detail)
    return 1


def find_rc(start_dir):
    d = os.path.abspath(start_dir)
    while True:
        cand = os.path.join(d, ".luacheckrc")
        if os.path.isfile(cand):
            return cand
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def main(argv):
    if argv and argv[0] == "--version":
        out = subprocess.run([LUACHECK, "--version"], capture_output=True,
                             text=True).stdout.splitlines()
        tool_line = out[0].strip() if out else "luacheck unknown"
        print(VERSION)
        print(tool_line)
        return 0

    args = argv[1:] if argv and argv[0] == "--" else argv
    try:
        out_idx = args.index("-o") if "-o" in args else args.index("--output")
        output_path = args[out_idx + 1]
        dep_idx = args.index("--depfile")
        depfile_path = args[dep_idx + 1]
        target = args[-2]  # {file_dir} is last
        file_dir = args[-1]
    except (ValueError, IndexError):
        return fail_loud("argv shape")

    with open(depfile_path, "w", encoding="utf-8") as f:
        f.write("%s: %s\n" % (output_path, target))
    with open(output_path, "w", encoding="utf-8"):
        pass

    cmd = [LUACHECK, "--formatter", "plain", "--codes", "--no-color"]
    rc = find_rc(file_dir)
    if rc:
        cmd += ["--config", rc]
    cmd.append(target)
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode not in (0, 1, 2):
        return fail_loud("luacheck exit %d: %s" % (proc.returncode,
                                                   proc.stderr.strip()[:200]))

    diags = []
    for line in proc.stdout.splitlines():
        if not line.strip():
            continue
        m = LINE_RE.match(line)
        if not m:
            return fail_loud(line[:200])
        line_no, col, code, msg = m.groups()
        sev = "ERROR" if code.startswith("E") else "WARNING"
        diags.append((int(line_no), int(col), sev, "%s %s" % (code, msg)))
    diags.sort(key=lambda d: (d[0], d[1]))

    err = sys.stderr
    err.write("stdin\n")
    n_err = 0
    for line_no, col, sev, msg in diags:
        if sev == "ERROR":
            n_err += 1
        err.write("%s: stdin:%d:%d: %s\n" % (sev, line_no, col, msg))
    if n_err:
        err.write("ERROR: %d compilation errors. No code generated.\n" % n_err)
        sys.stdout.write("SPIR-V is not generated for failed compile or link\n")
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
