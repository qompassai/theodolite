#!/usr/bin/env python3
"""cmakelint-check 1.0.0 -- theodolite checker wrapper (glslang profile).

Runs cmakelint over .cmake module files and translates its output
into the bridge's glslang info-log grammar. All cmakelint findings
are style-class: WARNING. Boundary: the bridge routes checkers by
extension, so CMakeLists.txt itself (extension .txt) is NOT
routable on this checker -- claiming "txt" would hijack every text
file. cmakelint exit codes: 0 clean, 1 findings; anything else
fails loud.
"""
import re
import subprocess
import sys

VERSION = "cmakelint-check 1.0.0"
CMAKELINT = "/home/phaedrus/.local/bin/cmakelint"
LINE_RE = re.compile(r"^.+?:(\d+): (.*)$")


def fail_loud(detail):
    sys.stdout.write("cmakelint-check: unparseable output: %s\n" % detail)
    return 1


def main(argv):
    if argv and argv[0] == "--version":
        proc = subprocess.run([CMAKELINT, "--version"], capture_output=True,
                              text=True)
        out = (proc.stdout + proc.stderr).splitlines()
        print(VERSION)
        print(out[0].strip() if out else "cmakelint unknown")
        return 0

    args = argv[1:] if argv and argv[0] == "--" else argv
    try:
        out_idx = args.index("-o") if "-o" in args else args.index("--output")
        output_path = args[out_idx + 1]
        dep_idx = args.index("--depfile")
        depfile_path = args[dep_idx + 1]
        target = args[-1]
    except (ValueError, IndexError):
        return fail_loud("argv shape")

    with open(depfile_path, "w", encoding="utf-8") as f:
        f.write("%s: %s\n" % (output_path, target))
    with open(output_path, "w", encoding="utf-8"):
        pass

    proc = subprocess.run([CMAKELINT, target], capture_output=True, text=True)
    if proc.returncode not in (0, 1):
        return fail_loud("cmakelint exit %d: %s" % (proc.returncode,
                                                    proc.stderr.strip()[:200]))
    diags = []
    for line in proc.stdout.splitlines():
        if not line.strip():
            continue
        m = LINE_RE.match(line)
        if not m:
            return fail_loud(line[:200])
        diags.append((int(m.group(1)), 1, "WARNING", m.group(2)))
    diags.sort(key=lambda d: (d[0], d[1]))

    err = sys.stderr
    err.write("stdin\n")
    for line_no, col, sev, msg in diags:
        err.write("%s: stdin:%d:%d: %s\n" % (sev, line_no, col, msg))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
